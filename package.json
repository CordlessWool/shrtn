{
	"name": "shrtn.to",
	"license": "MIT",
	"version": "2.10.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:cloudflare": "BUILD_FOR=cloudflare vite dev",
		"build": "vite build",
		"build:cloudflare": "BUILD_FOR=cloudflare vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:cloudflare": "wrangler d1 migrations apply SHRTN_D1",
		"db:studio": "drizzle-kit studio",
		"machine-translate": "inlang machine translate --project project.inlang",
		"test:e2e": "./e2e/scripts/node.sh",
		"test:e2e:smtp": "./e2e/scripts/smtp.sh",
		"test:e2e:docker": "./e2e/scripts/docker.sh",
		"test:e2e:cloudflare": "./e2e/scripts/cloudflare.sh"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@faker-js/faker": "^9.9.0",
		"@inlang/cli": "^3.1.11",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.64.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/mustache": "^4.2.6",
		"@types/nodemailer": "^7.0.11",
		"@types/qrcode": "^1.5.6",
		"autoprefixer": "^10.5.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"lucide-svelte": "^0.542.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"sveltekit-superforms": "^2.30.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.0",
		"valibot": "^1.4.1",
		"vite": "^7.3.5",
		"vitest": "^3.2.6",
		"wrangler": "^4.98.0"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.44.7",
		"isbot": "^5.1.42",
		"juice": "^11.1.1",
		"mustache": "^4.2.0",
